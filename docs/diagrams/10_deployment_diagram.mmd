graph TD
    subgraph ClientDevice["Client Environment (Browser & End-User Device)"]
        Browser[Modern Web Browser - Chrome / Edge / Firefox]
        ReactSPA[React 18 + Vite SPA Dashboard<br/>(Port :5173)]
        ChromeExt[Chrome Manifest v3 Extension<br/>(Background Service Worker & DOM Badge Overlay)]
        Browser --- ReactSPA
        Browser --- ChromeExt
    end

    subgraph HostServer["Application Host Server (Local Workstation / VM / Cloud Instance)"]
        subgraph PythonEnv["Python 3.10+ Virtual Environment"]
            FlaskAPI[Flask WSGI Application<br/>(Port :5000 / Gunicorn / Dev Server)]
            LimiterMiddleware[Flask-Limiter Memory/Redis Rate Guard]
            DistilBertEngine[DistilBERT PyTorch Transformer<br/>(CPU / CUDA Execution)]
            CaptumEngine[Captum XAI Engine<br/>(Integrated Gradients Token Attribution)]
            RegexHeuristics[Heuristic & Regex Rules Engine]
            Parsers[Document, OCR & Chat Export Parsers]
        end

        subgraph EmbeddedStorage["Local Relational Persistence Layer"]
            SQLite[(SQLite Embedded Database<br/>backend/data/shieldai.db<br/>Managed via SQLAlchemy ORM)]
        end
    end

    subgraph ExternalCloudServices["External Cloud & API Infrastructure (Optional with Offline Fallback)"]
        GroqAPI[Groq LLM API<br/>Model: openai/gpt-oss-120b]
        AnthropicAPI[Anthropic Claude API<br/>Model: claude-haiku-5-5]
    end

    %% Communication channels
    ReactSPA -->|HTTP / JSON via Vite Reverse Proxy| FlaskAPI
    ChromeExt -->|HTTP / JSON Batch API| FlaskAPI
    
    FlaskAPI --- LimiterMiddleware
    FlaskAPI --- DistilBertEngine
    FlaskAPI --- CaptumEngine
    FlaskAPI --- RegexHeuristics
    FlaskAPI --- Parsers
    
    FlaskAPI <-->|SQLAlchemy Sessions / SQL Queries| SQLite
    
    FlaskAPI -.->|HTTPS / API Key Authorization| GroqAPI
    FlaskAPI -.->|HTTPS / API Key Authorization| AnthropicAPI
