erDiagram
    users {
        ObjectId _id PK
        string username
        string password_hash
        string role "admin or analyst"
    }

    history {
        ObjectId _id PK
        string user_id FK
        string text "Analyzed content"
        string prediction "Primary category"
        float confidence
        float risk_score
        string severity_tier
        string actor_id FK
        boolean is_conversation
        date timestamp
    }

    actor_profiles {
        string _id PK "Hash of actor identifier"
        string identifier "Phone/Email/Username"
        int total_incidents
        float max_risk_score
        string threat_level "Low, Medium, High, Critical"
        array known_aliases
        date last_seen
    }

    complaints {
        ObjectId _id PK
        string reporter_name
        string contact_info
        string platform
        string incident_date
        string description
        string ai_summary "Generated by Groq"
        string source "public or admin"
        date submitted_at
    }

    users ||--o{ history : "performs analysis"
    actor_profiles ||--o{ history : "involved in"
