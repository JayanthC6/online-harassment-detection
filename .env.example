# ShieldAI Environment Configuration
APP_ENV=development

# Database Configuration (SQLite via SQLAlchemy by default, supports PostgreSQL)
SQLITE_DB_PATH=data/shieldai.db
# Or full SQLAlchemy URL:
# DATABASE_URL=sqlite:///data/shieldai.db
# DATABASE_URL=postgresql://user:password@localhost:5432/shieldai

# Authentication & Security
JWT_SECRET_KEY=replace-with-a-secure-random-jwt-secret-key-min-32-chars

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password

# CORS Settings (Comma-separated allowed origins for production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Chrome Extension Shared Key
EXTENSION_API_KEY=shieldai-ext-replace-with-secret-key

# LLM & Chatbot (Phase 4)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# External Threat Intelligence APIs (Optional)
GOOGLE_SAFE_BROWSING_API_KEY=

# Privacy & Data Retention (Days to retain reports, complaints, sessions; 0 to disable)
DATA_RETENTION_DAYS=90
