# MongoDB configuration (Docker setup uses the local container)
MONGODB_URI=mongodb://mongodb:27017/shieldai_db
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Required ML and External APIs
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here

# Security
JWT_SECRET_KEY=your_secure_jwt_secret_here

# Threat Intelligence (Optional but recommended)
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_key_here

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Other keys
EXTENSION_API_KEY=shieldai-ext-your_key_here
KAGGLE_API_TOKEN=your_kaggle_token_here
