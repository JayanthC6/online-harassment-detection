{
  "manifest_version": 3,
  "name": "ShieldAI",
  "version": "1.0.0",
  "description": "Digital safety scanning for Gmail and WhatsApp Web",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mail.google.com/*",
        "*://web.whatsapp.com/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShieldAI"
  }
}
